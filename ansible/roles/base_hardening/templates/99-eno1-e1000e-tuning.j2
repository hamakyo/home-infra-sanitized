#!/bin/sh
IFACE="$1"
ACTION="$2"
[ "$IFACE" = "{{ host_lan_interface }}" ] || exit 0
[ "$ACTION" = "up" ] || exit 0
if /usr/sbin/ethtool --show-eee "$IFACE" 2>/dev/null | grep -q "EEE status: enabled"; then
    /usr/sbin/ethtool --set-eee "$IFACE" eee off || true
fi
/usr/sbin/ethtool -K "$IFACE" tso off gso off || true
