# Infra Data & AI Hub (Step 1) environment file.
# Copy to .env (chmod 600 .env) and fill secrets. NEVER commit .env.

# PostgreSQL (pgvector/pgvector:0.8.7-pg17-trixie)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
ETL_WRITER_PASSWORD=
BI_READER_PASSWORD=
GRAFANA_DB_PASSWORD=

# Grafana OSS (https://bi.home.example.com)
GF_SECURITY_ADMIN_USER=breakglass-admin
GF_SECURITY_ADMIN_PASSWORD=
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=

# Read-Only Source APIs (host/pipeline only)
AUTHENTIK_API_URL=https://auth.home.example.com/api/v3
AUTHENTIK_API_TOKEN=
NETBOX_API_URL=https://netbox.home.example.com/api
NETBOX_API_TOKEN=
FLEET_API_URL=https://fleet.home.example.com/api/v1/fleet
FLEET_API_TOKEN=
ZABBIX_API_URL=https://zabbix.home.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=

# Monitoring (Zabbix Trapper)
ZABBIX_TRAPPER_HOST=ubuntu-desktop
ZABBIX_SERVER_CONTAINER=zabbix-server

# Step 2: Governed RAG & Read-Only MCP Gateway
RAG_READER_PASSWORD=
RAG_MCP_TOKEN=
SAKURA_AI_BASE_URL=https://api.ai.sakura.ad.jp/v1
SAKURA_AI_API_KEY=
RAG_EMBEDDING_MODEL=multilingual-e5-large

# Step 3 n8n DB roles on infra-dwh-postgres
N8N_DB_PASSWORD=replace_with_strong_password
N8N_RO_PASSWORD=replace_with_strong_password
