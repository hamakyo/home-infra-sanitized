# PostgreSQL password for n8n_app role on infra-dwh-postgres (must match stacks/data-platform/.env N8N_DB_PASSWORD)
DB_POSTGRESDB_PASSWORD=replace_with_strong_password

# 32-byte hex key used by n8n to encrypt stored credentials in PostgreSQL (back up safely!)
N8N_ENCRYPTION_KEY=replace_with_64_hex_chars

# Shared header token (X-Webhook-Token) for authenticating internal webhook triggers
N8N_WEBHOOK_TOKEN=replace_with_strong_random_token
