# Backblaze B2 S3-compatible Application Key (restricted to bucket: backup-home-infra-example)
AWS_ACCESS_KEY_ID=replace-with-b2-key-id
AWS_SECRET_ACCESS_KEY=replace-with-b2-application-key

# Restic repository URL and encryption password (store a copy outside home)
RESTIC_REPOSITORY=s3:https://s3.<B2_REGION>.backblazeb2.com/backup-home-infra-example/infra-db
RESTIC_PASSWORD=replace-with-strong-random-password

# Optional overrides
RESTIC_BIN=/home/infra-admin/.local/bin/restic
ZABBIX_HOST=ubuntu-desktop
ZABBIX_SERVER_CONTAINER=zabbix-server
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12
