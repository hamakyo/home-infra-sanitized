{
  "$schema": "https://opencode.ai/config.json",
  "model": "sakura/preview/DeepSeek-V4.1-Flash-1017",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "**/opencode.json*": "deny",
      "**/.opencode/**": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf *": "deny",
      "git push*": "deny",
      "env": "deny",
      "printenv*": "deny"
    },
    "infra-rag_*": "allow"
  },
  "agent": {
    "batch": {
      "description": "Read-only batch agent for scheduled reports and read-only checks",
      "mode": "primary",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "*.pem": "deny",
          "*.key": "deny"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "infra-rag_*": "allow"
      }
    }
  },
  "provider": {
    "sakura": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Sakura AI Engine",
      "options": {
        "baseURL": "https://api.ai.sakura.ad.jp/v1",
        "apiKey": "{env:SAKURA_AI_API_KEY}"
      },
      "models": {
        "preview/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek-V4.1-Flash-1017 (Sakura Preview)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "gpt-oss-120b": {
          "name": "gpt-oss-120b (Sakura)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "infra-rag": {
      "type": "remote",
      "url": "http://infra-rag-mcp:8080/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:RAG_MCP_TOKEN}"
      },
      "timeout": 30000
    }
  }
}
