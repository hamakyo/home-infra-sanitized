# Host-side thin wrapper config for OpenCode scheduled batch jobs.
# NEVER mount this file into the opencode container.
# chmod 600 .env

DISCORD_WEBHOOK_URL=
ZABBIX_API_URL=https://zabbix.home.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=
NETBOX_API_URL=https://netbox.home.example.com/api
NETBOX_API_TOKEN=
FLEET_API_URL=https://fleet.home.example.com/api/v1/fleet
FLEET_API_TOKEN=
GITHUB_REPO=example-user/home-infra-sanitized
HOME_INFRA_DIR=/home/infra-admin/dev/home-infra
OPENCODE_CONTAINER=opencode
OPENCODE_PRIMARY_MODEL=sakura/preview/DeepSeek-V4.1-Flash-1017
OPENCODE_FALLBACK_MODEL=opencode/deepseek-v4.1-flash-free
OPENCODE_TIMEOUT_SEC=120
OPENCODE_MAX_DAILY_RUNS=5
OPENCODE_LOG_DIR=/home/infra-admin/.local/state/opencode-jobs
