[Unit]
Description=Weekly Fleet + NetBox inventory and CVE digest via isolated OpenCode batch agent
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/infra-admin/dev/home-infra/stacks/opencode/jobs/weekly_inventory_cve.py
TimeoutStartSec=240
StandardOutput=journal
StandardError=journal
