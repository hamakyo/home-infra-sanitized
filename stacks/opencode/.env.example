# OpenCode server HTTP Basic Auth (required for opencode serve)
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace_with_strong_random_password

# Sakura AI Engine account token (<UUID>:<secret>, free tier: 3,000 req/month)
# Leave empty if using only OpenCode built-in free models temporarily
SAKURA_AI_API_KEY=

# Shared Bearer token for Read-Only Infra RAG MCP server (must match stacks/data-platform/.env)
RAG_MCP_TOKEN=replace_with_shared_rag_mcp_token
