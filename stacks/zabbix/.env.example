# Tailscale IP for Zabbix Server trapper/active-agent port 10051
ZBX_BIND_IP=100.64.0.10

# PostgreSQL credentials (e.g. generate with `openssl rand -hex 24`; never commit .env to git)
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=

# Display & timezone
ZBX_SERVER_NAME=Home Infra
TZ=Asia/Tokyo
