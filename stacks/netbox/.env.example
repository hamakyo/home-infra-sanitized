# PostgreSQL credentials (generate strong random values; never commit .env to git)
POSTGRES_DB=netbox
POSTGRES_USER=netbox
DB_PASSWORD=

# Valkey (Redis) passwords
REDIS_PASSWORD=
REDIS_CACHE_PASSWORD=

# Django SECRET_KEY & NetBox v2 API_TOKEN_PEPPER_1 (each must be >= 50 chars, e.g. `openssl rand -hex 32`)
SECRET_KEY=
API_TOKEN_PEPPER_1=

# Authentik OIDC SSO (set REMOTE_AUTH_ENABLED=true after creating the `netbox` OAuth2/OIDC provider in Authentik)
REMOTE_AUTH_ENABLED=false
SOCIAL_AUTH_OIDC_KEY=
SOCIAL_AUTH_OIDC_SECRET=
LOGOUT_REDIRECT_URL=https://auth.home.example.com/application/o/netbox/end-session/
